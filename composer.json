{
    "name": "horde/pack",
    "description": "Data packing library",
    "type": "library",
    "homepage": "https://www.horde.org/libraries/Horde_Pack",
    "license": "LGPL-2.1-only",
    "authors": [
        {
            "name": "Michael Slusarz",
            "email": "slusarz@horde.org",
            "role": "lead"
        }
    ],
    "keywords": [
        "serialization",
        "fast_compression"
    ],
    "time": "2026-06-10",
    "repositories": [],
    "require": {
        "php": "^8.1",
        "horde/compress_fast": "^2 || dev-FRAMEWORK_6_0",
        "horde/exception": "^3 || dev-FRAMEWORK_6_0"
    },
    "require-dev": {
        "horde/test": "^3 || dev-FRAMEWORK_6_0"
    },
    "suggest": {
        "ext-igbinary": "^1.2",
        "ext-msgpack": "*",
        "ext-json": "*"
    },
    "autoload": {
        "psr-0": {
            "Horde_Pack": "lib/"
        },
        "psr-4": {
            "Horde\\Pack\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Horde\\Pack\\Test\\": "test/"
        }
    },
    "config": {
        "allow-plugins": {}
    },
    "extra": {
        "branch-alias": {
            "dev-FRAMEWORK_6_0": "2.x-dev"
        }
    }
}